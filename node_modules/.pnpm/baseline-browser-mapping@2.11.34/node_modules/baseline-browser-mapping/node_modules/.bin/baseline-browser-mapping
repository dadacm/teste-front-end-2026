#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/dcm/Área de Trabalho/teste-front-end-2026/node_modules/.pnpm/baseline-browser-mapping@2.11.34/node_modules/baseline-browser-mapping/node_modules:/home/dcm/Área de Trabalho/teste-front-end-2026/node_modules/.pnpm/baseline-browser-mapping@2.11.34/node_modules:/home/dcm/Área de Trabalho/teste-front-end-2026/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/dcm/Área de Trabalho/teste-front-end-2026/node_modules/.pnpm/baseline-browser-mapping@2.11.34/node_modules/baseline-browser-mapping/node_modules:/home/dcm/Área de Trabalho/teste-front-end-2026/node_modules/.pnpm/baseline-browser-mapping@2.11.34/node_modules:/home/dcm/Área de Trabalho/teste-front-end-2026/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../dist/cli.cjs" "$@"
else
  exec node  "$basedir/../../dist/cli.cjs" "$@"
fi
